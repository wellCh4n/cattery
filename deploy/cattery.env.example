# Copy to cattery.env (gitignored). Both values are secrets.
#
# Signs login tokens; rotating it signs everyone out.
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me
# The existing Postgres. The database must exist; the backend applies its
# migrations on startup. URL-encode special characters in the password.
DATABASE_URL=postgres://cattery:change-me@postgres.example.com:5432/cattery?sslmode=disable
