DATABASE_URL=postgres://postgres:postgres@localhost:5432/cattery?sslmode=disable
PORT=8080
JWT_SECRET=change-me-generate-a-long-random-secret
K8S_NAMESPACE=default
# PVC storage. Leave K8S_STORAGE_CLASS empty to use the cluster's default
# StorageClass. K8S_PVC_ACCESS_MODE defaults to ReadWriteMany (what the
# shared-PVC design wants); set it to ReadWriteOnce on block-backed classes
# (EBS/PD/Azure Disk/local-path), which only support single-node mounts.
K8S_STORAGE_CLASS=
K8S_PVC_ACCESS_MODE=ReadWriteOnce
# Model providers (endpoints, keys, models) live in models.toml — copy
# models.example.toml. Override the path with:
# MODELS_CONFIG=models.toml
